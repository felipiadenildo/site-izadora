---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { person } from "../data/person";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer>
  <div class="mx-auto flex max-w-3xl flex-col-reverse items-start justify-between gap-3 px-4 py-6 text-xs text-ink-muted sm:flex-row sm:items-center sm:px-6">
    <p>© {year} {person.shortName}. {t("footer.rights")}</p>
    <a href="#top" class="hover:text-accent">{t("footer.backToTop")} ↑</a>
  </div>
</footer>
