---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { catalizaProject } from "../../data/person";
import SectionHeading from "../SectionHeading.astro";
import Pill from "../Pill.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
  <SectionHeading eyebrow={t("projects.eyebrow")} title={t("projects.title")} />

  <div class="mt-10 grid gap-5 sm:grid-cols-2">
    <a
      href={catalizaProject.repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex flex-col rounded-2xl border border-line/70 bg-paper p-6 shadow-soft transition-colors hover:border-petrol-700"
    >
      <h2 class="font-display text-lg font-semibold text-ink group-hover:text-petrol-900">
        {catalizaProject.name}
      </h2>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{catalizaProject.description[lang]}</p>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {catalizaProject.stack.map((tech) => <Pill>{tech}</Pill>)}
      </div>
      <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-petrol-800 group-hover:text-petrol-900">
        {t("projects.viewRepo")} →
      </span>
    </a>

    <div class="flex flex-col justify-center rounded-2xl border border-dashed border-amber-500/50 bg-amber-100/30 p-6">
      <p class="text-3xl" aria-hidden="true">🧪</p>
      <h2 class="mt-3 font-display text-lg font-semibold text-ink">{t("projects.comingSoonTitle")}</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft">{t("projects.comingSoonBody")}</p>
    </div>
  </div>
</div>
