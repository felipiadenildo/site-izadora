---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";
import { person } from "../../data/person";
import UnderConstruction from "../UnderConstruction.astro";
import SocialLinks from "../SocialLinks.astro";
import JumpNav from "../cv/JumpNav.astro";
import NewsList from "../cv/NewsList.astro";
import EducationList from "../cv/EducationList.astro";
import PublicationList from "../cv/PublicationList.astro";
import ProjectList from "../cv/ProjectList.astro";
import ParticipationList from "../cv/ParticipationList.astro";
import casualPhoto from "../../assets/photos/izadora-casual.jpeg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const sectionHeading = "font-mono text-xs font-semibold uppercase tracking-widest text-ink-muted";
const sectionWrap = "mx-auto max-w-3xl scroll-mt-20 px-4 py-9 sm:px-6";
---

<div id="top">
  {/* ---------- Hero ---------- */}
  <section class="mx-auto max-w-3xl px-4 pt-12 pb-8 sm:px-6 sm:pt-16">
    <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">{t("hero.location")}</p>
    <h1 class="mt-2 font-display text-4xl font-medium tracking-tight text-ink md:whitespace-nowrap">
      {person.name}
    </h1>
    <p class="mt-2 font-mono text-xs uppercase tracking-widest text-ink-muted">{t("hero.role")}</p>
    <p class="mt-5 font-display text-lg italic leading-relaxed text-ink/90 md:whitespace-nowrap">{t("hero.tagline")}</p>

    <div class="mt-8 border-t border-line/70 pt-5">
      <JumpNav />
    </div>
  </section>

  {/* ---------- News ---------- */}
  <section id="news" class={sectionWrap}>
    <h2 class={sectionHeading}>{t("section.news")}</h2>
    <div class="mt-3">
      <NewsList />
    </div>
  </section>

  {/* ---------- About ---------- */}
  <section id="about" class={sectionWrap}>
    <h2 class={sectionHeading}>{t("section.about")}</h2>
    <div class="mt-4 grid gap-6 sm:grid-cols-[1fr_9rem] sm:items-start">
      <div class="space-y-3 text-base leading-relaxed text-ink sm:order-1">
        <p>{t("about.body1")}</p>
        <p>{t("about.body2")}</p>
        <a href={translatePath("/journey/")} class="inline-block text-sm font-medium text-accent hover:underline">
          {t("about.journeyCta")} →
        </a>
      </div>
      <Image
        src={casualPhoto}
        alt={person.name}
        width={280}
        height={373}
        loading="eager"
        class="order-first w-28 shrink-0 rounded-lg border border-line object-cover sm:order-2 sm:w-full"
      />
    </div>
  </section>

  {/* ---------- Education ---------- */}
  <section id="education" class={sectionWrap}>
    <h2 class={sectionHeading}>{t("section.education")}</h2>
    <div class="mt-2">
      <EducationList />
    </div>
  </section>

  {/* ---------- Research ---------- */}
  <section id="research" class={sectionWrap}>
    <h2 class={sectionHeading}>{t("section.research")}</h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink">{t("research.summary")}</p>
    <p class="mt-3 text-sm text-ink-muted">
      {t("research.grantLabel")}:{" "}
      <a href={person.grantUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
        {person.grantNumber}
      </a>
      {" · "}
      {t("research.advisorLabel")}: {person.advisor}
    </p>
    <p class="mt-2 text-sm text-ink-muted">
      <span class="text-ink">{t("research.interestsLabel")}:</span> {person.researchInterests.join(", ")}
    </p>
  </section>

  {/* ---------- Publications ---------- */}
  <section id="publications" class={sectionWrap}>
    <div class="flex items-baseline justify-between gap-4">
      <h2 class={sectionHeading}>{t("section.publications")}</h2>
      <a
        href={person.orcidUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 text-sm text-accent hover:underline"
      >
        {t("publications.viewAll")}
      </a>
    </div>
    <div class="mt-2">
      <PublicationList />
    </div>
  </section>

  {/* ---------- Projects ---------- */}
  <section id="projects" class={sectionWrap}>
    <h2 class={sectionHeading}>{t("section.projects")}</h2>
    <div class="mt-2">
      <ProjectList />
    </div>
  </section>

  {/* ---------- Participation ---------- */}
  <section id="participation" class={sectionWrap}>
    <h2 class={sectionHeading}>{t("section.participation")}</h2>
    <div class="mt-2">
      <ParticipationList />
    </div>
  </section>

  {/* ---------- Contact ---------- */}
  <section id="contact" class={sectionWrap}>
    <h2 class={sectionHeading}>{t("section.contact")}</h2>
    <p class="mt-4 max-w-md text-sm text-ink-muted">{t("contact.note")}</p>
    <div class="mt-4">
      <SocialLinks class="-ml-2" />
    </div>
    <div class="mt-4 flex flex-col gap-2 sm:max-w-sm">
      <UnderConstruction message={t("contact.emailPending")} compact />
      <UnderConstruction message={`${t("contact.cvLabel")}: ${t("contact.cvPending")}`} compact />
    </div>
  </section>
</div>
