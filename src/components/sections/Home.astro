---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";
import { person, catalizaProject } from "../../data/person";
import { publications } from "../../data/publications";
import Pill from "../Pill.astro";
import labPhoto from "../../assets/photos/izadora-lab-sirius.jpeg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const latestPub = publications[0];
---

<div id="top">
  <section class="mx-auto max-w-5xl px-4 pt-10 pb-16 sm:px-6 sm:pt-16 sm:pb-24">
    <div class="grid items-center gap-10 md:grid-cols-[1.1fr_0.9fr] md:gap-12">
      <div>
        <p class="font-medium text-sm tracking-wide text-amber-600 uppercase">{t("hero.eyebrow")}</p>
        <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          {person.name}
        </h1>
        <p class="mt-5 font-display text-xl italic text-petrol-800 sm:text-2xl">{t("hero.tagline")}</p>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-soft">{t("hero.subtext")}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={translatePath("/research/")}
            class="rounded-full bg-petrol-900 px-5 py-2.5 text-sm font-medium text-paper shadow-soft transition-transform hover:-translate-y-0.5"
          >
            {t("hero.ctaResearch")}
          </a>
          <a
            href={translatePath("/about/") + "#cv"}
            class="rounded-full border border-line px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-petrol-700 hover:text-petrol-900"
          >
            {t("hero.ctaCV")}
          </a>
          <a
            href={translatePath("/contact/")}
            class="rounded-full px-5 py-2.5 text-sm font-medium text-ink-soft underline decoration-line underline-offset-4 hover:text-petrol-900 hover:decoration-amber-500"
          >
            {t("hero.ctaContact")}
          </a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-xs md:max-w-none">
        <div class="absolute -inset-3 -z-10 rotate-2 rounded-[2rem] bg-amber-100/70 sm:-inset-4"></div>
        <Image
          src={labPhoto}
          alt={t("hero.photoAlt")}
          width={640}
          height={800}
          class="w-full rounded-[1.75rem] border border-line/70 object-cover shadow-soft"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="border-t border-line/70 bg-paper-dim/60">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
      <h2 class="font-display text-xl font-semibold text-ink">{t("home.highlights")}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-line/70 bg-paper p-5 shadow-soft">
          <p class="text-xs font-medium uppercase tracking-wide text-ink-soft">{t("home.currentRole")}</p>
          <p class="mt-2 text-sm leading-relaxed text-ink">{t("home.currentRoleBody")}</p>
        </div>

        <a
          href={translatePath("/publications/")}
          class="group rounded-2xl border border-line/70 bg-paper p-5 shadow-soft transition-colors hover:border-petrol-700"
        >
          <p class="text-xs font-medium uppercase tracking-wide text-ink-soft">{t("home.latestPub")}</p>
          <p class="mt-2 text-sm leading-relaxed text-ink group-hover:text-petrol-900">
            {latestPub.title}
          </p>
          <p class="mt-2 text-xs text-ink-soft">{latestPub.journal} · {latestPub.year}</p>
        </a>

        <a
          href={catalizaProject.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-2xl border border-line/70 bg-paper p-5 shadow-soft transition-colors hover:border-petrol-700"
        >
          <p class="text-xs font-medium uppercase tracking-wide text-ink-soft">{t("home.featuredProject")}</p>
          <p class="mt-2 font-display text-base font-semibold text-ink group-hover:text-petrol-900">
            {catalizaProject.name}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{catalizaProject.description[lang]}</p>
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <a
      href={translatePath("/journey/")}
      class="group flex flex-col gap-4 rounded-2xl border border-line/70 bg-gradient-to-br from-petrol-900 to-petrol-800 p-6 text-paper shadow-soft transition-transform hover:-translate-y-0.5 sm:flex-row sm:items-center sm:justify-between sm:p-8"
    >
      <div>
        <h2 class="font-display text-xl font-semibold sm:text-2xl">{t("home.journeyTeaser.title")}</h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-paper/80 sm:text-base">
          {t("home.journeyTeaser.body")}
        </p>
      </div>
      <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-amber-500 px-4 py-2 text-sm font-medium text-petrol-950 transition-transform group-hover:translate-x-1">
        {t("home.journeyTeaser.cta")} →
      </span>
    </a>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
    <div class="flex flex-wrap gap-2">
      {person.researchInterests.map((topic) => <Pill tone="petrol">{topic}</Pill>)}
    </div>
  </section>
</div>
