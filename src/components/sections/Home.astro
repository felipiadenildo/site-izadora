---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";
import { person } from "../../data/person";
import UnderConstruction from "../UnderConstruction.astro";
import SocialLinks from "../SocialLinks.astro";
import JumpNav from "../cv/JumpNav.astro";
import EducationList from "../cv/EducationList.astro";
import PublicationList from "../cv/PublicationList.astro";
import ProjectList from "../cv/ProjectList.astro";
import ParticipationList from "../cv/ParticipationList.astro";
import labPhoto from "../../assets/photos/izadora-lab-sirius.jpeg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div id="top">
  {/* ---------- Hero ---------- */}
  <section class="mx-auto max-w-3xl px-4 pt-10 pb-8 sm:px-6 sm:pt-14">
    <div class="flex flex-col-reverse items-start gap-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
      <div>
        <p class="text-sm text-ink-muted">{t("hero.location")}</p>
        <h1 class="mt-1 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
          {person.name}
        </h1>
        <p class="mt-2 text-sm text-ink-muted">{t("hero.role")}</p>
        <p class="mt-4 max-w-md text-base leading-relaxed text-ink">{t("hero.tagline")}</p>
      </div>

      <Image
        src={labPhoto}
        alt={t("hero.photoAlt")}
        width={320}
        height={400}
        loading="eager"
        class="h-32 w-28 shrink-0 rounded-xl border border-line object-cover sm:h-40 sm:w-32"
      />
    </div>

    <div class="mt-8 border-t border-line/70 pt-5">
      <JumpNav />
    </div>
  </section>

  {/* ---------- About ---------- */}
  <section id="about" class="mx-auto max-w-3xl scroll-mt-20 border-t border-line/70 px-4 py-8 sm:px-6">
    <h2 class="font-display text-lg font-semibold text-ink">{t("section.about")}</h2>
    <div class="mt-4 max-w-2xl space-y-3 text-base leading-relaxed text-ink">
      <p>{t("about.body1")}</p>
      <p>{t("about.body2")}</p>
    </div>
    <a
      href={translatePath("/journey/")}
      class="mt-3 inline-block text-sm font-medium text-accent hover:underline"
    >
      {t("about.journeyCta")} →
    </a>
  </section>

  {/* ---------- Education ---------- */}
  <section id="education" class="mx-auto max-w-3xl scroll-mt-20 border-t border-line/70 px-4 py-8 sm:px-6">
    <h2 class="font-display text-lg font-semibold text-ink">{t("section.education")}</h2>
    <div class="mt-2">
      <EducationList />
    </div>
  </section>

  {/* ---------- Research ---------- */}
  <section id="research" class="mx-auto max-w-3xl scroll-mt-20 border-t border-line/70 px-4 py-8 sm:px-6">
    <h2 class="font-display text-lg font-semibold text-ink">{t("section.research")}</h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink">{t("research.summary")}</p>
    <p class="mt-3 text-sm text-ink-muted">
      {t("research.grantLabel")}:{" "}
      <a
        href={person.grantUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent hover:underline"
      >
        {person.grantNumber}
      </a>
      {" · "}{t("research.advisorLabel")}: {person.advisor}
    </p>
    <p class="mt-2 text-sm text-ink-muted">
      <span class="text-ink">{t("research.interestsLabel")}:</span> {person.researchInterests.join(", ")}
    </p>
  </section>

  {/* ---------- Publications ---------- */}
  <section id="publications" class="mx-auto max-w-3xl scroll-mt-20 border-t border-line/70 px-4 py-8 sm:px-6">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-display text-lg font-semibold text-ink">{t("section.publications")}</h2>
      <a
        href={person.orcidUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 text-sm text-accent hover:underline"
      >
        {t("publications.viewAll")}
      </a>
    </div>
    <div class="mt-2">
      <PublicationList />
    </div>
  </section>

  {/* ---------- Projects ---------- */}
  <section id="projects" class="mx-auto max-w-3xl scroll-mt-20 border-t border-line/70 px-4 py-8 sm:px-6">
    <h2 class="font-display text-lg font-semibold text-ink">{t("section.projects")}</h2>
    <div class="mt-2">
      <ProjectList />
    </div>
  </section>

  {/* ---------- Participation ---------- */}
  <section id="participation" class="mx-auto max-w-3xl scroll-mt-20 border-t border-line/70 px-4 py-8 sm:px-6">
    <h2 class="font-display text-lg font-semibold text-ink">{t("section.participation")}</h2>
    <div class="mt-2">
      <ParticipationList />
    </div>
  </section>

  {/* ---------- Contact ---------- */}
  <section id="contact" class="mx-auto max-w-3xl scroll-mt-20 border-t border-line/70 px-4 py-8 sm:px-6">
    <h2 class="font-display text-lg font-semibold text-ink">{t("section.contact")}</h2>
    <p class="mt-4 max-w-md text-sm text-ink-muted">{t("contact.note")}</p>
    <div class="mt-4">
      <SocialLinks class="-ml-2" />
    </div>
    <div class="mt-4 flex flex-col gap-2 sm:max-w-sm">
      <UnderConstruction message={t("contact.emailPending")} compact />
      <UnderConstruction message={`${t("contact.cvLabel")} — ${t("contact.cvPending")}`} compact />
    </div>
  </section>
</div>
