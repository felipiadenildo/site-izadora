---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import UnderConstruction from "../UnderConstruction.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
  <h1 class="font-display text-4xl font-medium tracking-tight text-ink sm:text-5xl">{t("nav.blog")}</h1>
  <p class="mt-3 font-mono text-xs uppercase tracking-widest text-highlight">{t("blog.empty.eyebrow")}</p>

  <div class="mt-6 max-w-md">
    <UnderConstruction message={t("blog.empty.body")} />
  </div>
</div>
