---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { timeline, type TimelineIcon } from "../../data/timeline";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ICONS: Record<TimelineIcon, string> = {
  notebook:
    '<rect x="6" y="3" width="14" height="18" rx="1.5"/><path d="M9 3v18M12 8h6M12 12h6M12 16h4"/><circle cx="4.4" cy="6" r=".6" fill="currentColor" stroke="none"/><circle cx="4.4" cy="10" r=".6" fill="currentColor" stroke="none"/><circle cx="4.4" cy="14" r=".6" fill="currentColor" stroke="none"/>',
  flask:
    '<path d="M9 2h6"/><path d="M10 2v6.2a3 3 0 0 1-.5 1.66L5.1 17.4A2 2 0 0 0 6.77 20.5h10.46a2 2 0 0 0 1.67-3.1l-4.4-7.54a3 3 0 0 1-.5-1.66V2"/>',
  compass: '<circle cx="12" cy="12" r="8.5"/><path d="m14.5 9.5-1.8 5.3-5.2 1.7 1.8-5.3z"/>',
  umbrella: '<path d="M4 12a8 8 0 0 1 16 0Z"/><path d="M12 12V20a2 2 0 0 1-2 2"/><path d="M12 4V2"/>',
  clipboard:
    '<rect x="5.5" y="4.5" width="13" height="17" rx="1.6"/><rect x="9" y="2.5" width="6" height="3.2" rx="1"/><path d="M8.5 11h7M8.5 14.5h7M8.5 18h4.5"/>',
  torii: '<path d="M2.5 7.2c3-1 16-1 19 0"/><path d="M4 5.6h16"/><path d="M7 6v15.4M17 5.6V21"/>',
  flaskRays:
    '<path d="M12 1v2.4M8.7 2 9.6 4M15.3 2 14.4 4"/><path d="M9.5 4.5h5"/><path d="M10.2 4.5v5.7a3 3 0 0 1-.5 1.63L5.9 18.9A2 2 0 0 0 7.6 22h8.8a2 2 0 0 0 1.7-3.1l-3.8-6.57a3 3 0 0 1-.5-1.63V4.5"/>',
};
---

<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
  <h1 class="font-display text-4xl font-medium tracking-tight text-ink sm:text-5xl">{t("nav.journey")}</h1>
  <p class="mt-3 max-w-xl text-base leading-relaxed text-ink-muted">{t("journey.intro")}</p>

  <ol class="mt-10">
    {
      timeline.map((entry, i) => (
        <li class="journey-stop" style={`--i:${i}`}>
          {i > 0 && (
            <svg
              class:list={["journey-connector", i % 2 === 1 && "is-flipped"]}
              width="40"
              height="46"
              viewBox="0 0 40 46"
              fill="none"
              aria-hidden="true"
            >
              <path d="M20 0 C 8 12, 32 24, 20 46" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="4 5" />
            </svg>
          )}

          <div class="journey-row">
            <span class:list={["journey-icon", entry.current && "journey-icon--current"]} aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={ICONS[entry.icon]}
              />
            </span>

            <div class="journey-content">
              <p class="font-mono text-xs uppercase tracking-wide text-highlight">
                {entry.period} · {entry.place}
              </p>
              <h2 class="mt-1 font-display text-lg font-semibold text-ink">{entry.title[lang]}</h2>
              <p class="mt-1.5 max-w-md text-sm leading-relaxed text-ink-muted">{entry.body[lang]}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .journey-stop {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }
  .journey-stop.is-in {
    opacity: 1;
    transform: translateY(0);
  }

  .journey-connector {
    display: block;
    margin-inline-start: 0.5rem;
    color: var(--color-line);
  }
  .journey-connector.is-flipped {
    transform: scaleX(-1);
  }

  .journey-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .journey-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    color: var(--color-ink-muted);
    background: var(--color-canvas);
  }
  .journey-icon--current {
    border-color: var(--color-tint-border);
    color: var(--color-highlight);
    background: var(--color-tint);
  }

  .journey-content {
    padding-bottom: 0.5rem;
    position: relative;
  }
</style>

<script>
  const stops = document.querySelectorAll(".journey-stop");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.2, rootMargin: "0px 0px -10% 0px" },
    );
    stops.forEach((stop) => observer.observe(stop));
  } else {
    stops.forEach((stop) => stop.classList.add("is-in"));
  }
</script>
