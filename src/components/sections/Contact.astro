---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { person } from "../../data/person";
import SectionHeading from "../SectionHeading.astro";
import UnderConstruction from "../UnderConstruction.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const profiles = [
  { label: "ORCID", href: person.orcidUrl, detail: person.orcid },
  { label: "Google Scholar", href: person.scholarUrl },
  { label: "ResearchGate", href: person.researchGateUrl },
  { label: "FAPESP (BV)", href: person.fapespUrl },
];
---

<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
  <SectionHeading eyebrow={t("contact.eyebrow")} title={t("contact.title")} />

  <p class="mt-6 max-w-xl text-sm leading-relaxed text-ink-soft">{t("contact.note")}</p>

  <div class="mt-10">
    <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-ink-soft">
      {t("contact.emailTitle")}
    </h2>
    <div class="mt-3 max-w-md">
      {
        person.email ? (
          <a
            href={`mailto:${person.email}`}
            class="text-lg font-medium text-petrol-800 underline decoration-amber-500 underline-offset-4 hover:text-petrol-900"
          >
            {person.email}
          </a>
        ) : (
          <UnderConstruction
            message={
              lang === "pt"
                ? "O e-mail de contato ainda está sendo purificado — enquanto isso, use um dos perfis abaixo."
                : "The contact email is still being purified — use one of the profiles below in the meantime."
            }
          />
        )
      }
    </div>
  </div>

  <div class="mt-10">
    <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-ink-soft">
      {t("contact.profilesTitle")}
    </h2>
    <ul class="mt-4 divide-y divide-line/70 rounded-2xl border border-line/70 bg-paper">
      {
        profiles.map((profile) => (
          <li>
            <a
              href={profile.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between gap-4 px-5 py-4 transition-colors hover:bg-paper-dim/60"
            >
              <span class="font-medium text-ink">{profile.label}</span>
              {profile.detail && <span class="text-sm text-ink-soft">{profile.detail}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
