---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
import { person } from "../data/person";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Strip the /pt prefix (if any) to get the "canonical" path used for both languages.
const bareCurrentPath = Astro.url.pathname.replace(/^\/pt(\/|$)/, "/");

const navItems: Array<{ href: string; label: string }> = [
  { href: "/", label: t("nav.home") },
  { href: "/about/", label: t("nav.about") },
  { href: "/research/", label: t("nav.research") },
  { href: "/publications/", label: t("nav.publications") },
  { href: "/projects/", label: t("nav.projects") },
  { href: "/contact/", label: t("nav.contact") },
];

const otherLang = lang === "en" ? "pt" : "en";
const langSwitchHref = useTranslatedPath(otherLang)(bareCurrentPath, otherLang);
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={translatePath("/")} class="group flex items-baseline gap-2 shrink-0">
      <span class="font-display text-lg font-semibold tracking-tight text-petrol-900"
        >{person.shortName}</span
      >
      <span class="hidden text-xs text-ink-soft sm:inline">{t("site.role")}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        {
          navItems.map((item) => {
            const isCurrent = bareCurrentPath === item.href;
            return (
              <li>
                <a
                  href={translatePath(item.href)}
                  aria-current={isCurrent ? "page" : undefined}
                  class:list={[
                    "rounded-full px-3 py-1.5 transition-colors",
                    isCurrent
                      ? "bg-petrol-900 text-paper"
                      : "text-ink-soft hover:bg-petrol-900/8 hover:text-petrol-900",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={langSwitchHref}
        class="rounded-full border border-line px-3 py-1.5 text-sm text-ink-soft transition-colors hover:border-petrol-700 hover:text-petrol-900"
      >
        {t("nav.langSwitch")}
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex items-center justify-center rounded-full border border-line p-2 text-ink md:hidden"
      >
        <span class="sr-only">Menu</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Primary mobile" hidden class="border-t border-line/70 md:hidden">
    <ul class="mx-auto flex max-w-5xl flex-col px-4 py-2 text-sm">
      {
        navItems.map((item) => {
          const isCurrent = bareCurrentPath === item.href;
          return (
            <li>
              <a
                href={translatePath(item.href)}
                aria-current={isCurrent ? "page" : undefined}
                class:list={[
                  "block rounded-md px-2 py-2.5",
                  isCurrent ? "font-medium text-petrol-900" : "text-ink-soft",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    if (menu) menu.hidden = isOpen;
  });
</script>
