---
import { getLangFromUrl } from "../../i18n/utils";
import { news } from "../../data/news";

const lang = getLangFromUrl(Astro.url);
---

<ul class="divide-y-0">
  {
    news.map((entry) => (
      <li class="grid grid-cols-[6.5rem_1fr] gap-4 py-3 sm:grid-cols-[8rem_1fr]">
        <span class="font-mono text-xs text-ink-muted">{entry.period}</span>
        {entry.href ? (
          <a href={entry.href} target="_blank" rel="noopener noreferrer" class="text-sm text-ink hover:text-accent">
            {entry.text[lang]}
          </a>
        ) : (
          <p class="text-sm text-ink">{entry.text[lang]}</p>
        )}
      </li>
    ))
  }
</ul>
