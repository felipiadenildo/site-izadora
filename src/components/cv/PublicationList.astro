---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { publications } from "../../data/publications";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ul class="divide-y divide-line/70">
  {
    publications.map((pub) => (
      <li class="grid grid-cols-[6.5rem_1fr] gap-4 py-3 sm:grid-cols-[8rem_1fr]">
        <span class="font-mono text-xs text-ink-muted">
          {pub.year}
          {pub.forthcoming && <span class="ml-1.5 text-highlight">· {t("publications.forthcoming")}</span>}
        </span>
        <div class="text-sm text-ink">
          <a
            href={`https://doi.org/${pub.doi}`}
            target="_blank"
            rel="noopener noreferrer"
            title={t("publications.openLink")}
            class="group inline"
          >
            <span class="group-hover:text-accent">{pub.title}</span>
            <svg
              class="ml-1 inline h-3 w-3 shrink-0 text-ink-muted group-hover:text-accent"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </a>
          <p class="text-ink-muted italic">{pub.journal}</p>
        </div>
      </li>
    ))
  }
</ul>
