---
import { getLangFromUrl } from "../../i18n/utils";
import { education } from "../../data/education";

const lang = getLangFromUrl(Astro.url);
---

<ul class="divide-y-0">
  {
    education.map((entry) => (
      <li class="grid grid-cols-[6.5rem_1fr] gap-4 py-3 sm:grid-cols-[8rem_1fr]">
        <span class="font-mono text-xs text-ink-muted">{entry.period}</span>
        <div class="text-sm text-ink">
          <span class="font-medium">{entry.degree[lang]}</span>
          {entry.current && <span class="ml-1.5 inline-block h-1.5 w-1.5 rounded-full bg-highlight align-middle" aria-hidden="true" />}
          <span class="text-ink-muted"> · {entry.institution}, {entry.place}</span>
        </div>
      </li>
    ))
  }
</ul>
