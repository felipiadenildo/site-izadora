---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  message?: string;
  compact?: boolean;
}

const { message, compact = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const text = message ?? t("underconstruction.default");
---

<div
  class:list={[
    "flex items-start gap-3 rounded-2xl border border-dashed border-amber-500/50 bg-amber-100/40 text-ink",
    compact ? "p-3" : "p-5",
  ]}
  role="note"
>
  <svg
    class="mt-0.5 h-6 w-6 shrink-0 text-amber-600 motion-safe:animate-[bounce_3s_ease-in-out_infinite]"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M9 2h6" />
    <path d="M10 2v6.2a3 3 0 0 1-.5 1.66L5.1 17.4A2 2 0 0 0 6.77 20.5h10.46a2 2 0 0 0 1.67-3.1l-4.4-7.54a3 3 0 0 1-.5-1.66V2" />
    <path d="M7.5 14.5h9" stroke-opacity="0.6" />
    <circle cx="10.5" cy="17.5" r="0.6" fill="currentColor" stroke="none" />
    <circle cx="13.5" cy="18.5" r="0.4" fill="currentColor" stroke="none" />
  </svg>
  <p class="text-sm leading-relaxed text-ink-soft">{text}</p>
</div>
