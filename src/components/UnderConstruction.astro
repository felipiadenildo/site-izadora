---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  message?: string;
  compact?: boolean;
}

const { message, compact = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const text = message ?? t("underconstruction.default");
---

<div
  class:list={[
    "flex items-center gap-2.5 rounded-xl border border-dashed border-tint-border/60 bg-tint/60",
    compact ? "px-3 py-2" : "px-4 py-3",
  ]}
  role="note"
>
  <svg
    class="h-4 w-4 shrink-0 text-highlight"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M9 2h6" />
    <path d="M10 2v6.2a3 3 0 0 1-.5 1.66L5.1 17.4A2 2 0 0 0 6.77 20.5h10.46a2 2 0 0 0 1.67-3.1l-4.4-7.54a3 3 0 0 1-.5-1.66V2" />
  </svg>
  <p class="text-sm text-ink-muted">{text}</p>
</div>
