---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { person } from "../data/person";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>404 · {person.shortName}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <div class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6">
        <p class="text-5xl" aria-hidden="true">🧪💥</p>
        <h1 class="mt-6 font-display text-3xl font-semibold text-ink sm:text-4xl">404 — Reagent not found</h1>
        <p class="mt-4 max-w-md text-base leading-relaxed text-ink-soft">
          Whatever you were looking for didn't survive the reaction. It may have evaporated, or never existed on
          this bench.
        </p>
        <a
          href="/"
          class="mt-8 rounded-full bg-petrol-900 px-5 py-2.5 text-sm font-medium text-paper shadow-soft hover:-translate-y-0.5 transition-transform"
        >
          Back to a known compound (home)
        </a>

        <hr class="my-10 w-16 border-line" />

        <h2 class="font-display text-xl font-semibold text-ink">404 — Reagente não encontrado</h2>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-soft">
          O que quer que você procurava não sobreviveu à reação. Pode ter evaporado, ou nunca ter existido nesta
          bancada.
        </p>
        <a
          href="/pt/"
          class="mt-6 rounded-full border border-line px-5 py-2 text-sm font-medium text-ink hover:border-petrol-700 hover:text-petrol-900"
        >
          Voltar a um composto conhecido (início)
        </a>
      </div>
    </main>
    <Footer />
  </body>
</html>
